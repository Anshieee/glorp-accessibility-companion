# .dockerignore — WHITELIST approach: exclude everything, then re-include what
# the build actually needs. This is for a public hosted demo image, so anything
# not explicitly included must not exist in the shipped build context, incl.:
#   .agents/.opencode/, opencode.json, skills-lock.json, logs/, .env*,
#   credentials, reports, PRD/handoff file, node_modules, build dirs.
*
# Root package manifests and configs
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.*.json
# Server source (TypeScript) + scan engine
!src/
!src/**
# Frontend (independent package, its own lockfile)
!web/
!web/package.json
!web/package-lock.json
!web/tsconfig.json
!web/tsconfig.*.json
!web/index.html
!web/vite.config.ts
!web/src/
!web/src/**
# Landing page (Next static export -> landing-page/out/, served at `/`;
# demo console web/dist is preserved at `/console`). pnpm-locked; sources
# only, never secrets.
!landing-page/
!landing-page/package.json
!landing-page/pnpm-lock.yaml
!landing-page/next.config.ts
!landing-page/next-env.d.ts
!landing-page/tsconfig.json
!landing-page/tailwind.config.ts
!landing-page/postcss.config.mjs
!landing-page/public/
!landing-page/public/**
!landing-page/src/
!landing-page/src/**
# Scan-engine test fixtures, publicly copied into the runtime image
!test/
!test/fixtures/
!test/fixtures/**
# Deploy plumbing used by the build itself
!Dockerfile
!.dockerignore

# Defense in depth after re-including source directories.
node_modules/
**/node_modules/
**/node_modules/**
dist/
**/dist/
**/dist/**
.next/
**/.next/
out/
**/out/
.env*
**/.env*
**/*.tsbuildinfo
**/.DS_Store
**/credentials*.json
**/service-account*.json
