{
  "name": "accessibility-companion",
  "version": "1.0.0",
  "private": true,
  "description": "Accessibility Companion — hosted demo backend: HTTP API + remote Streamable HTTP MCP sharing one Playwright/axe engine.",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "web:build": "npm --prefix web run build"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@google-cloud/storage": "8.4.0",
    "@modelcontextprotocol/sdk": "^1.21.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.2.0",
    "playwright": "^1.56.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  }
}
